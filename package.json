{
  "name": "little-lemon",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "homepage": "https://thomasscheiber.com",
  "scripts": {
    "dev": "vite",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-3000}",
    "start:prod": "sh -c 'PORT=${PORT:-3000}; bunx serve -s dist -l tcp://0.0.0.0:$PORT'",
    "test": "jest",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "bun run build",
    "deploy": "gh-pages -d build"
  },
  "dependencies": {
    "formik": "^2.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "react-router-hash-link": "^2.4.3",
    "styled-components": "^6.6.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@jest/environment": "^30.5.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router-hash-link": "^2.4.10",
    "@types/styled-components": "^5.1.36",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(ts|tsx|js|jsx)$": "ts-jest",
      "^.+\\.(svg|jpg|png)$": "<rootDir>/svgTransform.ts"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.cjs"
    ]
  }
}
